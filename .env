# HTTP Email API (Recommended for Render Free Tier - bypasses SMTP port blocking over port 443 HTTPS)
# Get a free key at https://resend.com (takes 30 seconds, 3,000 free emails/month)
RESEND_API_KEY=

# Optional: Brevo API key (https://brevo.com - 300 free emails/day)
BREVO_API_KEY=

# Traditional SMTP Configuration (Used when running locally or on unblocked hosts)
MAIL_SERVER=smtp19.mycloudmailbox.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=B3Communications@b3intelligence.com
MAIL_PASSWORD=Password123!
MAIL_DEFAULT_SENDER=B3Communications@b3intelligence.com
SENDER_NAME="B3 Communications"

# Application Security & Upload Settings
JWT_SECRET_KEY=jwt_secret_key
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
